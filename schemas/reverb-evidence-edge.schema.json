{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yanibhq.dev/reverb/evidence-edge/v1.json",
  "title": "Reverb temporal evidence edge",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "id",
    "workspace_id",
    "producer_repository_id",
    "consumer_repository_id",
    "producer_generation_id",
    "consumer_generation_id",
    "contract_kind",
    "definition_key",
    "stable_reference_id",
    "basis",
    "primary_path",
    "stratum_key",
    "registry_revision",
    "first_observed_at",
    "last_observed_at",
    "definition",
    "reference"
  ],
  "properties": {
    "schema": { "const": "reverb.evidence-edge" },
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^edg_sha256:[0-9a-f]{64}$" },
    "workspace_id": {
      "type": "string",
      "pattern": "^wsp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "producer_repository_id": {
      "type": "string",
      "pattern": "^(?:github:[1-9][0-9]*|local:sha256:[0-9a-f]{64})$"
    },
    "consumer_repository_id": {
      "type": "string",
      "pattern": "^(?:github:[1-9][0-9]*|local:sha256:[0-9a-f]{64})$"
    },
    "producer_generation_id": {
      "type": "string",
      "pattern": "^gen_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "consumer_generation_id": {
      "type": "string",
      "pattern": "^gen_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "contract_kind": {
      "enum": ["typescript_symbol", "openapi_operation", "protobuf_method", "protobuf_field"]
    },
    "definition_key": { "type": "string", "minLength": 1 },
    "stable_reference_id": { "type": "string", "pattern": "^ref_sha256:[0-9a-f]{64}$" },
    "basis": {
      "enum": ["exact", "registry_resolved", "heuristic", "declared_context", "behavioural_context"]
    },
    "primary_path": { "type": "object" },
    "stratum_key": { "type": "string", "minLength": 1 },
    "registry_revision": { "type": "string", "pattern": "^reg_sha256:[0-9a-f]{64}$" },
    "first_observed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$" },
    "last_observed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$" },
    "invalidated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$" },
    "invalidation_reason": {
      "enum": ["complete_reference_absence", "registry_revision_changed", "membership_removed"]
    },
    "definition": { "type": "object" },
    "reference": { "type": "object" }
  }
}
