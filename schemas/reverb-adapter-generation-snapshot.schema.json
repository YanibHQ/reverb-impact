{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yanibhq.dev/reverb/adapter-generation-snapshot/v1.json",
  "title": "Reverb adapter generation snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "workspace_id",
    "repository_id",
    "generation_id",
    "adapter_id",
    "adapter_version",
    "identity_version",
    "partitioning_version",
    "config_revision",
    "registry_revision",
    "state",
    "entries",
    "output_hash"
  ],
  "properties": {
    "schema": { "const": "reverb.adapter-generation-snapshot" },
    "schema_version": { "const": "1.0" },
    "workspace_id": {
      "type": "string",
      "pattern": "^wsp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^(?:github:[1-9][0-9]*|local:sha256:[0-9a-f]{64})$"
    },
    "generation_id": {
      "type": "string",
      "pattern": "^gen_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "adapter_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
    "adapter_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "identity_version": { "type": "integer", "minimum": 1 },
    "partitioning_version": { "type": "integer", "minimum": 1 },
    "config_revision": { "type": "string", "pattern": "^cfg_sha256:[0-9a-f]{64}$" },
    "registry_revision": { "type": "string", "pattern": "^reg_sha256:[0-9a-f]{64}$" },
    "state": { "enum": ["complete", "partial", "failed", "unsupported"] },
    "base_snapshot_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "entries": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "partition_key", "partition_hash"],
            "properties": {
              "kind": { "const": "replacement" },
              "partition_key": { "type": "string", "minLength": 1, "maxLength": 512 },
              "partition_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "partition_key"],
            "properties": {
              "kind": { "const": "tombstone" },
              "partition_key": { "type": "string", "minLength": 1, "maxLength": 512 }
            }
          }
        ]
      }
    },
    "output_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
