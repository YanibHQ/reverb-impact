{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yanibhq.dev/reverb/pull-request-overlay/v1.json",
  "title": "Reverb pull request overlay",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "id",
    "workspace_id",
    "repository_id",
    "base_generation_id",
    "base_sha",
    "head_sha",
    "head_tree_hash",
    "indexer_bundle_version",
    "config_revision",
    "registry_revision",
    "state",
    "supersession_key",
    "diff_hash",
    "started_at"
  ],
  "properties": {
    "schema": { "const": "reverb.pull-request-overlay" },
    "schema_version": { "const": "1.0" },
    "id": {
      "type": "string",
      "pattern": "^ovl_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^wsp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^(?:github:[1-9][0-9]*|local:sha256:[0-9a-f]{64})$"
    },
    "base_generation_id": {
      "type": "string",
      "pattern": "^gen_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "base_sha": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "head_sha": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "head_tree_hash": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
    "indexer_bundle_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "config_revision": { "type": "string", "pattern": "^cfg_sha256:[0-9a-f]{64}$" },
    "registry_revision": { "type": "string", "pattern": "^reg_sha256:[0-9a-f]{64}$" },
    "state": { "enum": ["building", "complete", "partial", "failed"] },
    "supersession_key": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "diff_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "result_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "started_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$" },
    "completed_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$" }
  }
}
