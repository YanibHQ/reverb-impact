{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yanibhq.dev/reverb/review-event/v1.json",
  "title": "Reverb append-only review event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "id",
    "workspace_id",
    "finding_occurrence_id",
    "finding_fingerprint",
    "actor",
    "authorization",
    "occurred_at",
    "versions",
    "labels",
    "reason",
    "note_hash",
    "output_hash"
  ],
  "properties": {
    "schema": { "const": "reverb.review-event" },
    "schema_version": { "const": "1.0" },
    "id": {
      "type": "string",
      "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "workspace_id": {
      "type": "string",
      "pattern": "^wsp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "finding_occurrence_id": { "type": "string", "pattern": "^occ_sha256:[0-9a-f]{64}$" },
    "finding_fingerprint": { "type": "string", "pattern": "^fnd_sha256:[0-9a-f]{64}$" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "domain_capability", "detector_author_conflict"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "enum": ["reviewer", "repository_owner", "workspace_admin"] },
        "domain_capability": { "type": "string", "minLength": 1 },
        "detector_author_conflict": { "type": "boolean" }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "authorized_at", "permission"],
      "properties": {
        "revision": { "type": "string", "pattern": "^reg_sha256:[0-9a-f]{64}$" },
        "authorized_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$" },
        "permission": { "const": "finding.review" }
      }
    },
    "occurred_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}T.*Z$" },
    "versions": { "type": "object" },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge", "impact", "action"],
      "properties": {
        "edge": { "enum": ["confirmed", "absent", "indeterminate"] },
        "impact": { "enum": ["breaking", "behavior_risk", "compatible", "indeterminate"] },
        "action": {
          "enum": [
            "coordinate",
            "already_coordinated",
            "accepted_risk",
            "dead_or_test_only",
            "no_action",
            "indeterminate"
          ]
        }
      }
    },
    "reason": { "type": "string", "minLength": 1 },
    "note_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "supersedes": {
      "type": "string",
      "pattern": "^rev_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "suppression_rule_id": { "type": "string", "pattern": "^sup_sha256:[0-9a-f]{64}$" },
    "output_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
