{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yanibhq.dev/reverb/adapter-semantic-partition/v1.json",
  "title": "Reverb adapter semantic partition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "workspace_id",
    "repository_id",
    "adapter_id",
    "adapter_version",
    "identity_version",
    "partitioning_version",
    "config_revision",
    "registry_revision",
    "partition_key",
    "owned_paths",
    "dependency_keys",
    "payload",
    "output_hash"
  ],
  "properties": {
    "schema": { "const": "reverb.adapter-semantic-partition" },
    "schema_version": { "const": "1.0" },
    "workspace_id": {
      "type": "string",
      "pattern": "^wsp_[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "repository_id": {
      "type": "string",
      "pattern": "^(?:github:[1-9][0-9]*|local:sha256:[0-9a-f]{64})$"
    },
    "adapter_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
    "adapter_version": { "type": "string", "minLength": 1, "maxLength": 128 },
    "identity_version": { "type": "integer", "minimum": 1 },
    "partitioning_version": { "type": "integer", "minimum": 1 },
    "config_revision": { "type": "string", "pattern": "^cfg_sha256:[0-9a-f]{64}$" },
    "registry_revision": { "type": "string", "pattern": "^reg_sha256:[0-9a-f]{64}$" },
    "partition_key": { "type": "string", "minLength": 1, "maxLength": 512 },
    "owned_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\u0000).+(?<!/)$"
      }
    },
    "dependency_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "payload": { "type": "object" },
    "output_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
