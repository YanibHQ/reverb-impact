{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.yanibhq.dev/reverb/coverage-record/v1.json",
  "title": "Reverb coverage record",
  "type": "object",
  "additionalProperties": false,
  "required": ["dimension", "state", "eligible", "processed", "skipped", "failed"],
  "properties": {
    "dimension": { "enum": ["repository", "tree", "file", "language", "parser", "adapter"] },
    "state": { "enum": ["complete", "partial", "failed", "unauthorized", "not_analysed"] },
    "eligible": { "type": "integer", "minimum": 0 },
    "processed": { "type": "integer", "minimum": 0 },
    "skipped": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "reason": { "type": "string" },
    "scope": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\u0000).+(?<!/)$"
    }
  }
}
