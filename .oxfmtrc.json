{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    "features/",
    "README.md",
    "node_modules/",
    "dist/",
    "coverage/",
    "artifacts/",
    "docs/verification/adapters/*.json",
    "docs/reverb-overview.html",
    "pnpm-lock.yaml"
  ]
}
